{
  "name": "mochi",
  "version": "1.0.0",
  "description": "Personal Windows desktop focus companion — a pixel-art bunny who keeps you on task",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "test": "jest --testEnvironment node",
    "build": "electron-builder --win portable"
  },
  "dependencies": {
    "electron-auto-launch": "^5.0.6",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "jest": "^29.7.0",
    "jimp": "^0.22.12"
  },
  "build": {
    "appId": "com.pavni.mochi",
    "productName": "Mochi",
    "asar": false,
    "win": {
      "target": "dir"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "modulePathIgnorePatterns": ["<rootDir>/dist/"],
    "moduleNameMapper": {
      "^electron$": "<rootDir>/test/__mocks__/electron.js"
    }
  }
}
